## You invoke this with --env android.release on the fastlane command
## Uploads a draft to the production track: the rollout stays manual in the Play Console
BETA_BUILD=false
BUILD_FOR_RELEASE=true
COLLECT_NETWORK_METRICS=false
MAIN_APP_IDENTIFIER=com.infomaniak.chat
REPLACE_ASSETS=true
SENTRY_ENVIRONMENT=production
SEPARATE_APKS=true
SHOW_REVIEW=true
SUPPLY_PACKAGE_NAME=com.infomaniak.chat
SUPPLY_RELEASE_STATUS=draft
SUPPLY_TRACK=production
SUPPLY_VALIDATE_ONLY=false
