save-exact=true
engine-strict=true
legacy-peer-deps=true

# npm 12 gate: the 9 git deps (mattermost + jitsi forks) are all DIRECT and SHA-pinned.
# root = direct deps only; a transitive git dep would fail loudly (EALLOWGIT) by design.
allow-git=root
# npm 12 accepts only all|none|root (no host scoping). The 3 jitsi tarballs (lib-jitsi-meet,
# react-native-dialog, strophe.js) are TRANSITIVE deps from github releases => all is required.
allow-remote=all

min-release-age=7
min-release-age-exclude[]=@infomaniak/*
